          "settings": {
            "title": "Small batches, on purpose",
            "text": "<p>Every drop is capped at a limited run. It keeps quality control tight and means nothing sits in a warehouse for a clearance rack.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_fit": {
          "type": "column",
          "settings": {
            "title": "Fit is non-negotiable",
            "text": "<p>Eleven months of revisions went into our first pattern. We'd rather delay a launch than ship a fit we're not obsessed with.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_direct": {
          "type": "column",
          "settings": {
            "title": "Built by people who wear it",
            "text": "<p>We're our own first customers. If it doesn't hold up to how we actually live and work, it doesn't make the cut.</p>",
