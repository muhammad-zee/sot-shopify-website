{%- liquid
  assign gap_desktop = section.settings.gap_desktop
  assign gap_mobile = section.settings.gap_mobile
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .reel-carousel-wrapper-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 15px;
    padding-right: 15px;
  }

  .reel-carousel-header-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .reel-carousel-title-{{ section.id }} {
    margin: 0;
    text-align: {{ section.settings.heading_alignment }};
    color: rgb(var(--color-foreground));
    flex: 1 1 auto;
  }

  /* --- TRACK ---
     Native horizontal scrolling with snap points. No JS is required to
     scroll it; the arrow buttons below are a progressive enhancement. */
  .reel-carousel-track-{{ section.id }} {
    --reel-cards: {{ section.settings.cards_mobile }};
    --reel-gap: {{ gap_mobile }}px;

    display: flex;
    gap: var(--reel-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: {% if section.settings.hide_scrollbar %}0{% else %}12px{% endif %};
  }

  {%- if section.settings.hide_scrollbar -%}
    .reel-carousel-track-{{ section.id }} {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .reel-carousel-track-{{ section.id }}::-webkit-scrollbar {
      display: none;
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .reel-carousel-track-{{ section.id }} {
      --reel-cards: {{ section.settings.cards_desktop }};
      --reel-gap: {{ gap_desktop }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel-carousel-track-{{ section.id }} {
      scroll-behavior: auto;
    }
  }

  /* Fractional card counts (e.g. 1.5) leave the next card peeking, which is
     what signals "this scrolls" without needing an arrow. */
  .reel-carousel-card-{{ section.id }} {
    flex: 0 0 calc((100% - (var(--reel-cards) - 1) * var(--reel-gap)) / var(--reel-cards));
    scroll-snap-align: start;
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: {{ section.settings.card_corner_radius }}px;
    overflow: hidden;
    background-color: {{ section.settings.letterbox_color }};
  }

  /* Media wrapper always fills the card exactly. Flex is opt-in for Contain
     mode only, where centering is actually needed. */
  .reel-media-{{ section.id }} {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
  }

  /* Safety net: whatever markup video_tag emits, any media inside the wrapper
     is forced to the card box. Prevents native-resolution overflow. */
  .reel-media-{{ section.id }} > video,
  .reel-media-{{ section.id }} > img,
  .reel-media-{{ section.id }} > div,
  .reel-media-{{ section.id }} > div > video {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: cover;
  }

  .reel-video-{{ section.id }}.is-fit-cover {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    max-height: none !important;
    min-width: 0 !important;
    min-height: 0 !important;
    object-fit: cover !important;
    object-position: var(--reel-pos-x, 50%) var(--reel-pos-y, 50%) !important;
    display: block !important;
  }

  .reel-media-{{ section.id }}.is-contain-mode {
    display: flex !important;
    align-items: var(--reel-align-y, center) !important;
    justify-content: var(--reel-align-x, center) !important;
  }

  .reel-video-{{ section.id }}.is-fit-contain {
    width: auto !important;
    height: auto !important;
    max-width: 100% !important;
    max-height: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    flex-shrink: 1 !important;
    object-fit: contain !important;
    display: block !important;
  }

  .reel-video-backdrop-{{ section.id }} {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    filter: blur(24px) brightness(0.6);
    transform: scale(1.15);
    z-index: 0;
  }

  .reel-media-{{ section.id }}.has-blur-backdrop .reel-video-{{ section.id }}.is-fit-contain {
    position: relative;
    z-index: 1;
  }

  .reel-carousel-card-{{ section.id }}::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 46%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 100%);
    pointer-events: none;
    z-index: 2;
  }

  .reel-product-overlay-{{ section.id }} {
    position: absolute;
    z-index: 3;
    bottom: 12px;
    left: 10px;
    right: 10px;
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    padding: 8px 12px;
    border-radius: 20px;
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .reel-product-overlay-{{ section.id }}:hover {
    transform: scale(1.03);
  }

  /* --- ARROWS ---
     Hidden until JS confirms it can drive them, so no-JS visitors are not
     shown controls that do nothing. Native scrolling still works for them. */
  .reel-carousel-buttons-{{ section.id }} {
    display: none;
    gap: 8px;
    flex: 0 0 auto;
  }

  .reel-carousel-buttons-{{ section.id }}.is-enabled {
    display: flex;
  }

  .reel-carousel-button-{{ section.id }} {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(var(--color-foreground), 0.35);
    border-radius: 50%;
    background-color: transparent;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }

  .reel-carousel-button-{{ section.id }}:hover:not([disabled]) {
    background-color: rgba(var(--color-foreground), 0.08);
  }

  .reel-carousel-button-{{ section.id }}[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .reel-carousel-button-{{ section.id }} svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .reel-carousel-button-{{ section.id }}--prev svg {
    transform: rotate(90deg);
  }

  .reel-carousel-button-{{ section.id }}--next svg {
    transform: rotate(-90deg);
  }
  /* --- BOTTOM NAV (dots + pause) --- */
  .reel-carousel-nav-{{ section.id }} {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 18px;
  }

  .reel-carousel-nav-{{ section.id }}.is-enabled {
    display: flex;
  }

  .reel-carousel-dots-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .reel-carousel-dot-{{ section.id }} {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: rgba(var(--color-foreground), 0.25);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .reel-carousel-dot-{{ section.id }}:hover {
    background-color: rgba(var(--color-foreground), 0.5);
  }

  .reel-carousel-dot-{{ section.id }}[aria-current='true'] {
    background-color: rgb(var(--color-foreground));
    transform: scale(1.3);
  }

  /* Pause control is visually hidden but stays in the tab order, so mouse
     visitors never see it while keyboard/AT users keep a way to stop the
     rotation (WCAG 2.2.2). It reveals itself on keyboard focus. */
  .reel-carousel-pause-{{ section.id }} {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    border: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    background-color: transparent;
    color: rgb(var(--color-foreground));
    cursor: pointer;
  }

  .reel-carousel-pause-{{ section.id }}:focus-visible {
    position: static;
    width: 32px;
    height: 32px;
    margin: 0;
    overflow: visible;
    clip: auto;
    clip-path: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(var(--color-foreground), 0.35);
    border-radius: 50%;
  }

  /* Without visible dots the nav row collapses, so drop its spacing too. */
  .reel-carousel-nav-{{ section.id }}:not(:has(.reel-carousel-dot-{{ section.id }})) {
    margin-top: 0;
  }

  .reel-carousel-pause-{{ section.id }} svg {
    width: 10px;
    height: 10px;
    fill: currentColor;
  }

{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="reel-carousel-wrapper-{{ section.id }}">
    {%- if section.settings.heading != blank or section.settings.show_arrows -%}
      <div class="reel-carousel-header-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="reel-carousel-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.show_arrows -%}
          <div class="reel-carousel-buttons-{{ section.id }}" data-reel-carousel-buttons>
            <button
              type="button"
              class="reel-carousel-button-{{ section.id }} reel-carousel-button-{{ section.id }}--prev"
              data-reel-prev
              aria-controls="ReelCarousel-{{ section.id }}"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
            >
              {% render 'icon-caret' %}
            </button>
            <button
              type="button"
              class="reel-carousel-button-{{ section.id }} reel-carousel-button-{{ section.id }}--next"
              data-reel-next
              aria-controls="ReelCarousel-{{ section.id }}"
              aria-label="{{ 'general.slider.next_slide' | t }}"
            >
              {% render 'icon-caret' %}
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      role="region" + tabindex makes the overflow container reachable and
      scrollable by keyboard, which a bare div with overflow-x is not.
    {%- endcomment -%}
    <div
      class="reel-carousel-track-{{ section.id }}"
      id="ReelCarousel-{{ section.id }}"
      role="region"
      tabindex="0"
      aria-label="{{ section.settings.heading | default: 'Reels' | strip_html | escape }}"
    >
      {% for block in section.blocks %}
        {%- liquid
          assign fit = block.settings.video_fit
          if fit == 'default'
            assign fit = section.settings.default_video_fit
          endif

          assign position = block.settings.video_position
          if position == 'default'
            assign position = section.settings.default_video_position
          endif

          assign video_class = 'reel-video-' | append: section.id | append: ' is-fit-' | append: fit
          assign backdrop_class = 'reel-video-backdrop-' | append: section.id

          case position
            when 'top_left'
              assign align_x = 'flex-start'
              assign align_y = 'flex-start'
              assign pos_x = '0%'
              assign pos_y = '0%'
            when 'top_center'
              assign align_x = 'center'
              assign align_y = 'flex-start'
              assign pos_x = '50%'
              assign pos_y = '0%'
            when 'top_right'
              assign align_x = 'flex-end'
              assign align_y = 'flex-start'
              assign pos_x = '100%'
              assign pos_y = '0%'
            when 'center_left'
              assign align_x = 'flex-start'
              assign align_y = 'center'
              assign pos_x = '0%'
              assign pos_y = '50%'
            when 'center_right'
              assign align_x = 'flex-end'
              assign align_y = 'center'
              assign pos_x = '100%'
              assign pos_y = '50%'
            when 'bottom_left'
              assign align_x = 'flex-start'
              assign align_y = 'flex-end'
              assign pos_x = '0%'
              assign pos_y = '100%'
            when 'bottom_center'
              assign align_x = 'center'
              assign align_y = 'flex-end'
              assign pos_x = '50%'
              assign pos_y = '100%'
            when 'bottom_right'
              assign align_x = 'flex-end'
              assign align_y = 'flex-end'
              assign pos_x = '100%'
              assign pos_y = '100%'
            else
              assign align_x = 'center'
              assign align_y = 'center'
              assign pos_x = '50%'
              assign pos_y = '50%'
          endcase
        -%}
        <div
          class="reel-carousel-card-{{ section.id }}"
          {%- if block.settings.video_title != blank %}
            role="group"
            aria-label="{{ block.settings.video_title | strip_html | escape }}"
          {%- endif %}
          {{ block.shopify_attributes }}
        >
          <div
            class="reel-media-{{ section.id }}{% if fit == 'contain' %} is-contain-mode{% endif %}{% if fit == 'contain' and block.settings.blur_backdrop %} has-blur-backdrop{% endif %}"
            style="--reel-align-x: {{ align_x }}; --reel-align-y: {{ align_y }}; --reel-pos-x: {{ pos_x }}; --reel-pos-y: {{ pos_y }};"
          >
            {% if block.settings.video != blank %}
              {% if fit == 'contain' and block.settings.blur_backdrop %}
                {{
                  block.settings.video
                  | video_tag: autoplay: false, loop: true, muted: true, playsinline: true, controls: false, class: backdrop_class
                }}
              {% endif %}
              {{
                block.settings.video
                | video_tag:
                  autoplay: false,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  controls: false,
                  class: video_class
              }}
            {% endif %}
          </div>

          {%- liquid
            assign buy_url = blank
            assign buy_label = blank

            unless block.settings.hide_button
              if block.settings.button_link != blank
                assign buy_url = block.settings.button_link
              elsif block.settings.product != blank
                assign buy_url = block.settings.product.url
              elsif section.settings.default_button_link != blank
                assign buy_url = section.settings.default_button_link
              endif

              if buy_url != blank
                if block.settings.button_label != blank
                  assign buy_label = block.settings.button_label
                elsif block.settings.product != blank and block.settings.button_link == blank
                  assign buy_label = 'Shop ' | append: block.settings.product.title
                elsif section.settings.default_button_label != blank
                  assign buy_label = section.settings.default_button_label
                else
                  assign buy_label = 'Shop Now'
                endif
              endif
            endunless
          -%}

          {% if buy_url != blank %}
            <a href="{{ buy_url }}" class="reel-product-overlay-{{ section.id }}">
              <span>{{ buy_label }}</span>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {%- if section.settings.show_dots or section.settings.autoplay -%}
      {%- comment -%}
        Populated by JS: dot count depends on how many scroll pages the track
        actually has, which is only knowable after layout.
      {%- endcomment -%}
      <div class="reel-carousel-nav-{{ section.id }}" data-reel-nav>
        {%- if section.settings.show_dots -%}
          <div
            class="reel-carousel-dots-{{ section.id }}"
            data-reel-dots
            role="tablist"
            aria-label="Carousel pages"
          ></div>
        {%- endif -%}

        {%- if section.settings.autoplay -%}
          <button
            type="button"
            class="reel-carousel-pause-{{ section.id }}"
            data-reel-pause
            aria-controls="ReelCarousel-{{ section.id }}"
          ></button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var track = document.getElementById('ReelCarousel-{{ section.id }}');
    if (!track) return;

    var wrapper = track.closest('.reel-carousel-wrapper-{{ section.id }}');
    if (!wrapper) return;

    var buttons = wrapper.querySelector('[data-reel-carousel-buttons]');
    var prev = buttons && buttons.querySelector('[data-reel-prev]');
    var next = buttons && buttons.querySelector('[data-reel-next]');
    var nav = wrapper.querySelector('[data-reel-nav]');
    var dotsWrap = wrapper.querySelector('[data-reel-dots]');
    var pauseBtn = wrapper.querySelector('[data-reel-pause]');

    var cards = track.querySelectorAll('.reel-carousel-card-{{ section.id }}');
    if (!cards.length) return;

    var perSlide = {{ section.settings.cards_per_slide | default: 1 }};
    var autoplayOn = {% if section.settings.autoplay %}true{% else %}false{% endif %};
    var interval = {{ section.settings.autoplay_interval | default: 5 }} * 1000;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // --- Geometry -------------------------------------------------------
    function gap() {
      var s = window.getComputedStyle(track);
      return parseFloat(s.columnGap || s.gap) || 0;
    }

    function cardStep() {
      return cards[0].getBoundingClientRect().width + gap();
    }

    // One "slide" is however many cards the merchant chose to advance by.
    function slideStep() {
      return cardStep() * perSlide;
    }

    function maxScroll() {
      return track.scrollWidth - track.clientWidth;
    }

    // 2px of slack absorbs sub-pixel rounding at the scroll extremes.
    function atEnd() {
      return track.scrollLeft >= maxScroll() - 2;
    }

    function pageCount() {
      var step = slideStep();
      if (step <= 0) return 1;
      return Math.max(1, Math.ceil(maxScroll() / step) + 1);
    }

    function currentPage() {
      var step = slideStep();
      if (step <= 0) return 0;
      return Math.min(pageCount() - 1, Math.round(track.scrollLeft / step));
    }

    function goTo(left) {
      track.scrollTo({
        left: left,
        behavior: reduceMotion.matches ? 'auto' : 'smooth'
      });
    }

    function advance() {
      // Wrap to the start instead of stalling, so autoplay keeps cycling.
      if (atEnd()) goTo(0);
      else goTo(track.scrollLeft + slideStep());
    }

    function retreat() {
      if (track.scrollLeft <= 2) goTo(maxScroll());
      else goTo(track.scrollLeft - slideStep());
    }

    // --- Arrows ---------------------------------------------------------
    if (buttons && prev && next) {
      buttons.classList.add('is-enabled');
      prev.addEventListener('click', function () {
        retreat();
        restart();
      });
      next.addEventListener('click', function () {
        advance();
        restart();
      });
    }

    // --- Dots -----------------------------------------------------------
    // Built from measured geometry rather than block count, so a peeking
    // layout doesn't produce dots that scroll nowhere.
    var dots = [];

    function buildDots() {
      if (!dotsWrap) return;
      var total = pageCount();
      if (dots.length === total) return;

      dotsWrap.innerHTML = '';
      dots = [];

      if (total < 2) return;

      for (var i = 0; i < total; i++) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'reel-carousel-dot-{{ section.id }}';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1) + ' of ' + total);
        (function (index) {
          dot.addEventListener('click', function () {
            goTo(Math.min(index * slideStep(), maxScroll()));
            restart();
          });
        })(i);
        dotsWrap.appendChild(dot);
        dots.push(dot);
      }
    }

    function syncUi() {
      if (prev) prev.disabled = false;
      if (next) next.disabled = false;

      var active = currentPage();
      for (var i = 0; i < dots.length; i++) {
        dots[i].setAttribute('aria-current', i === active ? 'true' : 'false');
      }

      if (nav) {
        var worthShowing = dots.length > 1 || !!pauseBtn;
        nav.classList.toggle('is-enabled', worthShowing);
      }
    }

    // --- Autoplay -------------------------------------------------------
    var timer = null;
    var userPaused = false;

    // Only one card in total means there is nothing to rotate to.
    var canAutoplay = autoplayOn && !reduceMotion.matches && maxScroll() > 2;

    function play() {
      if (!canAutoplay || userPaused || timer) return;
      timer = setInterval(advance, interval);
      if (pauseBtn) {
        pauseBtn.textContent = '❚❚';
        pauseBtn.setAttribute('aria-label', 'Pause carousel');
      }
    }

    function stop(isUser) {
      if (isUser) userPaused = true;
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
      if (isUser && pauseBtn) {
        pauseBtn.textContent = '▶';
        pauseBtn.setAttribute('aria-label', 'Play carousel');
      }
    }

    function restart() {
      // Keeps a full interval after any manual interaction rather than
      // yanking the carousel onward a moment later.
      if (!timer) return;
      stop(false);
      play();
    }

    if (pauseBtn) {
      pauseBtn.textContent = '❚❚';
      pauseBtn.setAttribute('aria-label', 'Pause carousel');
      pauseBtn.addEventListener('click', function () {
        if (timer) {
          stop(true);
        } else {
          userPaused = false;
          play();
        }
      });
    }

    if (canAutoplay) {
      // WCAG 2.2.2: moving content must be pausable, and must not fight the
      // visitor while they are reading, hovering or tabbing through it.
      track.addEventListener('mouseenter', function () { stop(false); });
      track.addEventListener('mouseleave', function () { if (!userPaused) play(); });
      track.addEventListener('focusin', function () { stop(false); });
      track.addEventListener('focusout', function () { if (!userPaused) play(); });
      track.addEventListener('touchstart', function () { stop(false); }, { passive: true });
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stop(false);
        else if (!userPaused) play();
      });
    }

    // --- Lazy playback --------------------------------------------------
    var videos = track.querySelectorAll('video');

    videos.forEach(function (video) {
      video.preload = 'none';
      video.muted = true;
      video.setAttribute('muted', '');
      video.playsInline = true;
    });

    if (videos.length && !reduceMotion.matches) {
      if (!('IntersectionObserver' in window)) {
        videos.forEach(function (video) {
          video.preload = 'metadata';
          var attempt = video.play();
          if (attempt && attempt.catch) attempt.catch(function () {});
        });
      } else {
        // root: track means "visible within the carousel viewport", so cards
        // scrolled off to the side stop playing even though the section
        // itself is still on screen.
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              var video = entry.target;
              if (entry.isIntersecting) {
                if (video.preload !== 'auto') video.preload = 'auto';
                var attempt = video.play();
                if (attempt && attempt.catch) attempt.catch(function () {});
              } else if (!video.paused) {
                video.pause();
              }
            });
          },
          { root: track, threshold: 0.4 }
        );
        videos.forEach(function (video) {
          observer.observe(video);
        });
      }
    }

    // --- Wiring ---------------------------------------------------------
    var scrollTick = null;
    track.addEventListener(
      'scroll',
      function () {
        if (scrollTick) return;
        scrollTick = window.requestAnimationFrame(function () {
          scrollTick = null;
          syncUi();
        });
      },
      { passive: true }
    );

    window.addEventListener('resize', function () {
      canAutoplay = autoplayOn && !reduceMotion.matches && maxScroll() > 2;
      buildDots();
      syncUi();
      if (!canAutoplay) stop(false);
      else if (!userPaused) play();
    });

    buildDots();
    syncUi();
    play();
  })();
</script>

{%- comment -%}
  One VideoObject per reel. Skipped per block unless the block supplies the
  four properties Google requires, so an incompletely configured reel simply
  contributes no markup rather than invalid markup.
{%- endcomment -%}
{%- if section.settings.enable_video_schema and section.settings.videos_upload_date != blank -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign reel_name = block.settings.video_title | strip_html | strip_newlines | strip
      assign reel_desc = block.settings.video_description | strip_html | strip_newlines | strip
      assign reel_thumb = block.settings.video.preview_image

      assign reel_ready = false
      if block.settings.video != blank and reel_thumb != blank
        if reel_name != blank and reel_desc != blank
          assign reel_ready = true
        endif
      endif
    -%}
    {%- if reel_ready -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "VideoObject",
          "name": {{ reel_name | json }},
          "description": {{ reel_desc | json }},
          "thumbnailUrl": [{{ reel_thumb | image_url: width: 1080 | prepend: 'https:' | json }}],
          "uploadDate": {{ section.settings.videos_upload_date | json }}
          {%- for source in block.settings.video.sources -%}
            {%- if source.format == 'mp4' -%}
              ,"contentUrl": {{ source.url | json }}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        }
      </script>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

