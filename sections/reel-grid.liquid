{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .reel-grid-wrapper-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 15px;
    padding-right: 15px;
  }

  .reel-grid-title-{{ section.id }} {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 24px;
    color: rgb(var(--color-foreground));
  }

  .reel-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: {{ section.settings.grid_gap_mobile }}px;
  }

  @media screen and (min-width: 768px) {
    .reel-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: {{ section.settings.grid_gap_desktop }}px;
    }
  }

  .reel-grid-card-{{ section.id }} {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: {{ section.settings.card_corner_radius }}px;
    overflow: hidden;
    background-color: #000000;
  }

  .reel-video-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Per-block focal point, set via inline custom properties on the card */
    object-position: var(--reel-pos-x, 50%) var(--reel-pos-y, 50%);
    display: block;
  }

  /* Always-present bottom scrim so every card carries the same weight,
     whether or not it ends up with a button on top of it. */
  .reel-grid-card-{{ section.id }}::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 46%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 100%);
    pointer-events: none;
  }

  .reel-product-overlay-{{ section.id }} {
    position: absolute;
    z-index: 1;
    bottom: 12px;
    left: 10px;
    right: 10px;
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    padding: 8px 12px;
    border-radius: 20px;
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .reel-product-overlay-{{ section.id }}:hover {
    transform: scale(1.03);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="reel-grid-wrapper-{{ section.id }}">
    {% if section.settings.heading != blank %}
      <h2 class="reel-grid-title-{{ section.id }}">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="reel-grid-{{ section.id }}">
      {% for block in section.blocks %}
        <div
          class="reel-grid-card-{{ section.id }}"
          style="--reel-pos-x: {{ block.settings.position_x }}%; --reel-pos-y: {{ block.settings.position_y }}%;"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.video != blank %}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'reel-video-' | append: section.id }}
          {% endif %}

          {%- liquid
            assign buy_url = blank
            assign buy_label = blank

            unless block.settings.hide_button
              if block.settings.button_link != blank
                assign buy_url = block.settings.button_link
              elsif block.settings.product != blank
                assign buy_url = block.settings.product.url
              elsif section.settings.default_button_link != blank
                assign buy_url = section.settings.default_button_link
              endif

              if buy_url != blank
                if block.settings.button_label != blank
                  assign buy_label = block.settings.button_label
                elsif block.settings.product != blank and block.settings.button_link == blank
                  assign buy_label = 'Shop ' | append: block.settings.product.title
                elsif section.settings.default_button_label != blank
                  assign buy_label = section.settings.default_button_label
                else
                  assign buy_label = 'Shop Now'
                endif
              endif
            endunless
          -%}

          {% if buy_url != blank %}
            <a href="{{ buy_url }}" class="reel-product-overlay-{{ section.id }}">
              <span>{{ buy_label }}</span>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reels Grid",
  "settings": [
    {
      "type": "header",
      "content": "Theme Styling"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch & Shop Our Reels"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Default Buy Button",
      "info": "Applied to any reel that doesn't set its own link or product, so every card in the grid looks consistent."
    },
    {
      "type": "url",
      "id": "default_button_link",
      "label": "Default button link",
      "info": "e.g. your 'Shop All' collection. Leave blank to allow buttonless cards."
    },
    {
      "type": "text",
      "id": "default_button_label",
      "label": "Default button label",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Maximum Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Grid Columns & Gaps"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_gap_desktop",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Desktop Grid Gap",
      "default": 20
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Mobile Grid Gap",
      "default": 12
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Select Vertical MP4 Video"
        },
        {
          "type": "header",
          "content": "Video position in card"
        },
        {
          "type": "range",
          "id": "position_x",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Horizontal position",
          "info": "0% = left edge, 50% = center, 100% = right edge",
          "default": 50
        },
        {
          "type": "range",
          "id": "position_y",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Vertical position",
          "info": "0% = top, 50% = center, 100% = bottom. Use this to keep faces/subjects in frame when the card crops the video.",
          "default": 50
        },
        {
          "type": "header",
          "content": "Buy button"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "info": "Product, collection, page, or any URL. Takes priority over the tagged product and the section default."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label (optional)",
          "info": "Leave blank to use the section default label."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Tagged product (fallback)",
          "info": "Used only if no link is set above."
        },
        {
          "type": "checkbox",
          "id": "hide_button",
          "label": "Hide button on this reel",
          "info": "Overrides everything above, including the section default — use for reels with no CTA at all.",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reels Grid",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}