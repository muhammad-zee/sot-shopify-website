    "faq": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"sot-faq\">\n  <div class=\"sot-faq-inner\">\n    <h2 class=\"sot-faq-heading\">Before you order</h2>\n\n    <details class=\"sot-faq-item\" open>\n      <summary>Can I pay cash on delivery?</summary>\n      <div class=\"sot-faq-answer\">\n        <p>Yes. We offer cash on delivery anywhere in Pakistan. We call every customer to confirm the order before we dispatch it.</p>\n      </div>\n    </details>\n\n    <details class=\"sot-faq-item\">\n      <summary>How long does delivery take?</summary>\n      <div class=\"sot-faq-answer\">\n        <p>Orders are dispatched within 2 working days and arrive 2 to 3 working days after dispatch, with tracking via Leopards, TCS or PostEx. See our <a href=\"/pages/shipping-policy\">Shipping Policy</a> for current delivery charges.</p>\n      </div>\n    </details>\n\n    <details class=\"sot-faq-item\">\n      <summary>How do I find my size?</summary>\n      <div class=\"sot-faq-answer\">\n        <p>Every product page has a Size &amp; Fit Guide with exact measurements in inches and centimetres. All pieces are unisex, so order the size you normally wear.</p>\n      </div>\n    </details>\n\n    <details class=\"sot-faq-item\">\n      <summary>Can I return or exchange an item?</summary>\n      <div class=\"sot-faq-answer\">\n        <p>Please read our <a href=\"/pages/return-and-refund-policy\">Return and Refund Policy</a> before ordering. Questions? Call <a href=\"tel:03196336294\">0319-6336294</a> or email <a href=\"mailto:support@sotstudio.pk\">support@sotstudio.pk</a>.</p>\n      </div>\n    </details>\n  </div>\n</section>\n\n<style>\n.sot-faq {\n  width: 100%;\n  padding: 48px 16px;\n  background: #f5efe6;\n  box-sizing: border-box;\n  font-family: inherit;\n}\n\n.sot-faq-inner {\n  max-width: 800px;\n  margin: 0 auto;\n}\n\n.sot-faq-heading {\n  margin: 0 0 24px;\n  color: #111111;\n  font-size: 28px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  line-height: 1.2;\n  text-align: center;\n  text-transform: uppercase;\n}\n\n.sot-faq-item {\n  border-bottom: 1px solid #d8c3a5;\n}\n\n.sot-faq-item:first-of-type {\n  border-top: 1px solid #d8c3a5;\n}\n\n.sot-faq-item summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 16px 0;\n  color: #111111;\n  cursor: pointer;\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 1.4;\n  list-style: none;\n}\n\n.sot-faq-item summary::-webkit-details-marker {\n  display: none;\n}\n\n.sot-faq-item summary::after {\n  content: \"+\";\n  flex-shrink: 0;\n  color: #111111;\n  font-size: 20px;\n  font-weight: 400;\n  line-height: 1;\n}\n\n.sot-faq-item[open] summary::after {\n  content: \"\\2212\";\n}\n\n.sot-faq-answer {\n  padding: 0 32px 16px 0;\n}\n\n.sot-faq-answer p {\n  margin: 0;\n  color: #3d3a35;\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.sot-faq-answer a {\n  color: #111111;\n  font-weight: 600;\n  text-decoration: underline;\n}\n\n@media screen and (max-width: 749px) {\n  .sot-faq {\n    padding: 32px 16px;\n  }\n\n  .sot-faq-heading {\n    margin-bottom: 18px;\n    font-size: 20px;\n    letter-spacing: 1px;\n  }\n\n  .sot-faq-item summary {\n    padding: 14px 0;\n    font-size: 14px;\n  }\n\n  .sot-faq-answer {\n    padding-right: 0;\n  }\n\n  .sot-faq-answer p {\n    font-size: 13px;\n  }\n}\n</style>"
