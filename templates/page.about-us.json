        "text_story": {
          "type": "text",
          "settings": {
            "text": "<p>SOT started with a simple frustration: everyday clothing that looked good on a hanger and fell apart in wear. So three engineers did what engineers do &mdash; they treated the problem like a system. Eleven months of pattern revisions later, the first run of three hundred units sold out. We haven't stopped iterating since.</p>",
            "text_style": "subtitle"
          }
        },
