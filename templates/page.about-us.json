        "heading_philosophy": {
          "type": "heading",
          "settings": {
            "heading": "Clothing engineered like a product, not chased like a trend",
            "heading_size": "h1"
          }
        },
        "text_philosophy": {
          "type": "text",
          "settings": {
            "text": "<p>We don't chase seasons or churn out collections to fill a calendar. Every piece earns its place through fit testing, fabric sourcing, and real-world wear before it ever goes into production. If it's not better than what's already in your wardrobe, we don't make it.</p>"
          }
        }
