{%- comment -%}
  Slim promo strip with an optional live countdown.
  Hides itself automatically once the end date has passed (server-side on render, and client-side on the open page).
{%- endcomment -%}
{%- liquid
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign end_ts = 0
  if section.settings.end_datetime != blank
    assign end_ts = section.settings.end_datetime | date: '%s' | plus: 0
  endif
  assign expired = false
  if end_ts > 0 and now_ts > end_ts
    assign expired = true
  endif
-%}

{%- unless expired or section.settings.text == blank -%}
  <div
    class="sot-sale-strip color-{{ section.settings.color_scheme }}"
    id="SotSaleStrip-{{ section.id }}"
    {% if end_ts > 0 %}data-end="{{ end_ts }}"{% endif %}
  >
    <div class="sot-sale-strip__inner page-width">
      {%- if section.settings.link != blank -%}
        <a class="sot-sale-strip__text" href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        <span class="sot-sale-strip__text">{{ section.settings.text }}</span>
      {%- endif -%}

      {%- if section.settings.show_countdown and end_ts > 0 -%}
        <span class="sot-sale-strip__timer" aria-live="off">
          <span class="sot-sale-strip__label">{{ section.settings.countdown_label }}</span>
          <span class="sot-sale-strip__clock" data-clock>--:--:--</span>
        </span>
      {%- endif -%}
    </div>
  </div>

  <style>
    #SotSaleStrip-{{ section.id }} {
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
    }
    #SotSaleStrip-{{ section.id }} .sot-sale-strip__inner {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.4rem 1.6rem;
      padding-top: 1rem;
      padding-bottom: 1rem;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 0.12rem;
      font-size: 1.3rem;
      font-weight: 600;
    }
    #SotSaleStrip-{{ section.id }} .sot-sale-strip__text {
      color: inherit;
      text-decoration: none;
    }
    #SotSaleStrip-{{ section.id }} a.sot-sale-strip__text:hover {
      text-decoration: underline;
    }
    #SotSaleStrip-{{ section.id }} .sot-sale-strip__timer {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 500;
    }
    #SotSaleStrip-{{ section.id }} .sot-sale-strip__clock {
      font-variant-numeric: tabular-nums;
      font-weight: 700;
      padding: 0.2rem 0.8rem;
      border: 1px solid currentColor;
    }
    @media screen and (max-width: 749px) {
      #SotSaleStrip-{{ section.id }} .sot-sale-strip__inner {
        font-size: 1.15rem;
        letter-spacing: 0.08rem;
      }
    }
  </style>

  {%- if section.settings.show_countdown and end_ts > 0 -%}
    <script>
      (function () {
        var strip = document.getElementById('SotSaleStrip-{{ section.id }}');
        if (!strip) return;
        var end = parseInt(strip.getAttribute('data-end'), 10) * 1000;
        var clock = strip.querySelector('[data-clock]');
        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function tick() {
          var diff = end - Date.now();
          if (diff <= 0) { strip.style.display = 'none'; return; }
          var s = Math.floor(diff / 1000);
          var d = Math.floor(s / 86400); s -= d * 86400;
          var h = Math.floor(s / 3600); s -= h * 3600;
          var m = Math.floor(s / 60); s -= m * 60;
          clock.textContent = (d > 0 ? d + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
          setTimeout(tick, 1000);
        }
        tick();
      })();
    </script>
  {%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "SOT sale strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Blessed Friday · 30% off everything"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "Ends in"
    },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "Sale ends at",
      "info": "Format: 2026-11-29T23:59:00+05:00. The strip hides itself after this time."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "SOT sale strip"
    }
  ]
}
{% endschema %}
