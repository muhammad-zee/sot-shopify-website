{{ 'banner-slider.css' | asset_url | stylesheet_tag }}

<div class="banner-slider" id="banner-slider-{{ section.id }}">
  {% for block in section.blocks %}
    {% if block.type == 'slide' %}
      <div class="banner-slide {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" {% if block.settings.open_new_tab %}target="_blank"{% endif %}>
        {% endif %}

        {% if block.settings.image_web != blank or block.settings.image_mobile != blank %}
          <picture>
            {% if block.settings.image_mobile != blank %}
              <source media="(max-width: 768px)" srcset="{{ block.settings.image_mobile | image_url: width: 1200 }}">
            {% endif %}
            {% if block.settings.image_web != blank %}
              {{ block.settings.image_web | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750,1000,1500,2000' }}
            {% else %}
              {{ block.settings.image_mobile | image_url: width: 1200 | image_tag: loading: 'lazy' }}
            {% endif %}
          </picture>
        {% else %}
          <div class="banner-placeholder">Image Nahi Lagi</div>
        {% endif %}

        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}

  {% if section.blocks.size > 1 %}
    <div class="banner-dots"></div>
  {% endif %}
</div>

<style>
  .banner-slider {
    width: 100%;
    margin: 0;
    padding: 0;
    position: relative;
    overflow: hidden;
    line-height: 0;
  }
  .banner-slide { width: 100%; display: none; }
  .banner-slide.active { display: block; }
  .banner-slide a { display: block; width: 100%; line-height: 0; }
  .banner-slide picture { display: block; width: 100%; line-height: 0; }
  .banner-slide img { width: 100%; height: auto; display: block; object-fit: cover; }
  .banner-placeholder {
    width: 100%; padding: 80px 20px; text-align: center;
    background: #eee; color: #888; font-family: sans-serif;
  }
  .banner-dots {
    position: absolute; bottom: 15px; left: 0; right: 0;
    display: flex; justify-content: center; gap: 8px; z-index: 5;
  }
  .banner-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: rgba(255,255,255,0.5); cursor: pointer; transition: background 0.3s;
  }
  .banner-dot.active { background: #fff; }
</style>

<script>
  (function() {
    const sliderId = "banner-slider-{{ section.id }}";
    const slider = document.getElementById(sliderId);
    if (!slider) return;

    const slides = slider.querySelectorAll('.banner-slide');
    const dotsContainer = slider.querySelector('.banner-dots');
    const speed = {{ section.settings.slide_speed | times: 1000 }};
    let current = 0;
    let timer;

    if (slides.length <= 1) return;

    if (dotsContainer) {
      slides.forEach((_, i) => {
        const dot = document.createElement('div');
        dot.classList.add('banner-dot');
        if (i === 0) dot.classList.add('active');
        dot.addEventListener('click', () => goToSlide(i));
        dotsContainer.appendChild(dot);
      });
    }
    const dots = dotsContainer ? dotsContainer.querySelectorAll('.banner-dot') : [];

    function showSlide(index) {
      slides.forEach(s => s.classList.remove('active'));
      dots.forEach(d => d.classList.remove('active'));
      slides[index].classList.add('active');
      if (dots[index]) dots[index].classList.add('active');
      current = index;
    }

    function nextSlide() {
      showSlide((current + 1) % slides.length);
    }

    function goToSlide(index) {
      showSlide(index);
      resetTimer();
    }

    function startTimer() {
      timer = setInterval(nextSlide, speed);
    }

    function resetTimer() {
      clearInterval(timer);
      startTimer();
    }

    startTimer();
    slider.addEventListener('mouseenter', () => clearInterval(timer));
    slider.addEventListener('mouseleave', startTimer);
  })();
</script>

{% schema %}
{
  "name": "Auto Banner Slider",
  "settings": [
    {
      "type": "select",
      "id": "slide_speed",
      "label": "Slide Speed",
      "options": [
        { "value": "3", "label": "3 Seconds" },
        { "value": "4", "label": "4 Seconds" },
        { "value": "5", "label": "5 Seconds" },
        { "value": "6", "label": "6 Seconds" },
        { "value": "7", "label": "7 Seconds" }
      ],
      "default": "4"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_web",
          "label": "Desktop / Web Banner Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Banner Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Banner URL (kahan redirect karna hai)"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "New tab mein open karo",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Auto Banner Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
