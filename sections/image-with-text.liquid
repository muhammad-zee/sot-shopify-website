{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .hero-banner-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    {% if section.settings.full_screen %}
      min-height: 100svh;
      min-height: 100vh;
    {% else %}
      min-height: {{ section.settings.custom_height_mobile }}px;
    {% endif %}
  }
  @media screen and (min-width: 750px) {
    .hero-banner-{{ section.id }} {
      {% if section.settings.full_screen %}
        min-height: 100svh;
        min-height: 100vh;
      {% else %}
        min-height: {{ section.settings.custom_height_desktop }}px;
      {% endif %}
    }
  }

  .hero-banner-{{ section.id }} .hero-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-banner-{{ section.id }} .hero-banner__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .hero-banner-{{ section.id }} .hero-banner__media--mobile {
    display: block;
  }
  .hero-banner-{{ section.id }} .hero-banner__media--desktop {
    display: none;
  }
  @media screen and (min-width: 750px) {
    .hero-banner-{{ section.id }} .hero-banner__media--mobile {
      display: none;
    }
    .hero-banner-{{ section.id }} .hero-banner__media--desktop {
      display: block;
    }
  }

  .hero-banner-{{ section.id }} .hero-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .hero-banner-{{ section.id }} .hero-banner__content {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding: 4rem 2.4rem;
    color: {{ section.settings.text_color }};
    {% if section.settings.content_position == 'top' %}
      justify-content: flex-start;
    {% elsif section.settings.content_position == 'bottom' %}
      justify-content: flex-end;
    {% else %}
      justify-content: center;
    {% endif %}
    {% if section.settings.content_alignment == 'left' %}
      align-items: flex-start;
      text-align: left;
    {% elsif section.settings.content_alignment == 'right' %}
      align-items: flex-end;
      text-align: right;
    {% else %}
      align-items: center;
      text-align: center;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .hero-banner-{{ section.id }} .hero-banner__content {
      padding: 6rem 6rem;
    }
  }

  .hero-banner-{{ section.id }} .hero-banner__inner {
    max-width: 640px;
  }

  .hero-banner-{{ section.id }} .hero-banner__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.5em 1.2em;
    margin-bottom: 1.6rem;
    border-radius: 999px;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background-color: {{ section.settings.badge_color }};
    color: {{ section.settings.badge_text_color }};
  }

  .hero-banner-{{ section.id }} .hero-banner__heading {
    margin: 0 0 1.6rem;
    color: inherit;
    line-height: 1.1;
  }

  .hero-banner-{{ section.id }} .hero-banner__text {
    margin: 0 0 2rem;
    color: inherit;
  }

  .hero-banner-{{ section.id }} .hero-banner__trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin-bottom: 2rem;
    {% if section.settings.content_alignment == 'center' %}
      justify-content: center;
    {% elsif section.settings.content_alignment == 'right' %}
      justify-content: flex-end;
    {% endif %}
  }
  .hero-banner-{{ section.id }} .hero-banner__trust-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.3rem;
    color: inherit;
  }
  .hero-banner-{{ section.id }} .hero-banner__trust-item svg {
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
  }

  .hero-banner-{{ section.id }} .hero-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    {% if section.settings.content_alignment == 'center' %}
      justify-content: center;
    {% elsif section.settings.content_alignment == 'right' %}
      justify-content: flex-end;
    {% endif %}
  }

  .hero-banner-{{ section.id }} .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 3.4rem;
    border-radius: 0.4rem;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    border: 1px solid {{ section.settings.button_bg_color }};
    transition: opacity 0.15s ease;
  }
  .hero-banner-{{ section.id }} .hero-cta:hover {
    opacity: 0.85;
  }
  .hero-banner-{{ section.id }} .hero-cta--secondary {
    background-color: transparent;
    color: {{ section.settings.button_secondary_text_color }};
    border: 1px solid {{ section.settings.button_secondary_text_color }};
  }

  .hero-banner-{{ section.id }} .hero-cta__wrap {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    {% if section.settings.content_alignment == 'center' %}
      align-items: center;
    {% elsif section.settings.content_alignment == 'right' %}
      align-items: flex-end;
    {% else %}
      align-items: flex-start;
    {% endif %}
  }
  .hero-banner-{{ section.id }} .hero-cta__support {
    font-size: 1.2rem;
    opacity: 0.85;
    color: inherit;
  }

  .hero-banner-{{ section.id }} .hero-banner__sticky-cta {
    display: none;
  }
  @media screen and (max-width: 749px) {
    .hero-banner-{{ section.id }} .hero-banner__sticky-cta {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      padding: 1rem 1.6rem calc(1rem + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(6px);
      box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.12);
    }
    .hero-banner-{{ section.id }} .hero-banner__sticky-cta .hero-cta {
      width: 100%;
      background-color: {{ section.settings.button_bg_color }};
      color: {{ section.settings.button_text_color }};
      border-color: {{ section.settings.button_bg_color }};
    }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  assign sticky_label = blank
  assign sticky_link = blank
-%}

<div class="hero-banner-{{ section.id }} hero-banner">
  <div class="hero-banner__media hero-banner__media--desktop">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: sizes: '100vw', widths: '750, 1100, 1500, 1780, 2000, 2400', fetchpriority: fetch_priority
      }}
    {%- else -%}
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="hero-banner__media hero-banner__media--mobile">
    {%- if section.settings.image_mobile != blank -%}
      {{
        section.settings.image_mobile
        | image_url: width: 1200
        | image_tag: sizes: '100vw', widths: '375, 550, 750, 900, 1200', fetchpriority: fetch_priority
      }}
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1200
        | image_tag: sizes: '100vw', widths: '375, 550, 750, 900, 1200', fetchpriority: fetch_priority
      }}
    {%- else -%}
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="hero-banner__overlay"></div>
  {%- endif -%}

  <div class="hero-banner__content">
    <div class="hero-banner__inner">
      {%- for block in section.blocks -%}
        {% case block.type %}
          {%- when 'badge' -%}
            {%- if block.settings.text != blank -%}
              <span class="hero-banner__badge" {{ block.shopify_attributes }}>
                {{ block.settings.text | escape }}
              </span>
            {%- endif -%}
          {%- when 'heading' -%}
            <h2 class="hero-banner__heading inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h2>
          {%- when 'text' -%}
            <div class="hero-banner__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'trust_item' -%}
            {%- if block.settings.label != blank -%}
              <div class="hero-banner__trust-row" {{ block.shopify_attributes }}>
                <span class="hero-banner__trust-item">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M7 12.5L10.2 15.5L17 8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {{ block.settings.label | escape }}
                </span>
              </div>
            {%- endif -%}
          {%- when 'button' -%}
            {%- if block.settings.button_label != blank -%}
              {%- if sticky_label == blank -%}
                {%- assign sticky_label = block.settings.button_label -%}
                {%- assign sticky_link = block.settings.button_link -%}
              {%- endif -%}
              <div class="hero-banner__buttons" {{ block.shopify_attributes }}>
                <div class="hero-cta__wrap">
                  
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="hero-cta{% if block.settings.button_style_secondary %} hero-cta--secondary{% endif %}"
                  >
                    {{ block.settings.button_label | escape }}
                  </a>
                  {%- if block.settings.supporting_text != blank -%}
                    <span class="hero-cta__support">{{ block.settings.supporting_text | escape }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.sticky_mobile_cta and sticky_label != blank -%}
  <div class="hero-banner-{{ section.id }} hero-banner__sticky-cta">
    
      {% if sticky_link == blank %}
        role="link" aria-disabled="true"
      {% else %}
        href="{{ sticky_link }}"
      {% endif %}
      class="hero-cta"
    >
      {{ sticky_label | escape }}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hero banner (full screen)",
  "class": "section section--hero-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Optional. Falls back to the desktop image if not set." },
    { "type": "checkbox", "id": "full_screen", "label": "Full screen height (100vh)", "default": true },
    { "type": "range", "id": "custom_height_mobile", "min": 300, "max": 900, "step": 10, "unit": "px", "label": "Mobile height (if not full screen)", "default": 500 },
    { "type": "range", "id": "custom_height_desktop", "min": 400, "max": 1200, "step": 10, "unit": "px", "label": "Desktop height (if not full screen)", "default": 700 },
    {
      "type": "select",
      "id": "content_position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center",
      "label": "Vertical content position"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Horizontal content alignment"
    },
    { "type": "header", "content": "Overlay & text" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image overlay darkness", "default": 30 },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "header", "content": "Badge" },
    { "type": "color", "id": "badge_color", "label": "Badge background", "default": "#ffffff" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#121212" },
    { "type": "header", "content": "Buttons" },
    { "type": "color", "id": "button_bg_color", "label": "Primary button background", "default": "#121212" },
    { "type": "color", "id": "button_text_color", "label": "Primary button text", "default": "#ffffff" },
    { "type": "color", "id": "button_secondary_text_color", "label": "Secondary button text/border", "default": "#ffffff" },
    { "type": "checkbox", "id": "sticky_mobile_cta", "label": "Show sticky CTA bar on mobile", "default": false }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Eyebrow badge",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "default": "Limited Time Offer", "label": "Badge text" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "Your headline here", "label": "Heading" },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" }
          ],
          "default": "h0",
          "label": "Heading size"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "default": "<p>Add supporting copy that makes visitors want to act.</p>", "label": "Text" },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "subtitle", "label": "Subtitle" }
          ],
          "default": "body",
          "label": "Text style"
        }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust signal",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "default": "Free shipping on all orders", "label": "Trust signal text" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "button_label", "default": "Shop Now", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "checkbox", "id": "button_style_secondary", "default": false, "label": "Use secondary (outline) style" },
        { "type": "text", "id": "supporting_text", "label": "Supporting microcopy" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner (full screen)",
      "blocks": [
        { "type": "badge" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "trust_item" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}