{% comment %}
  Renders the "Size & Fit Guide" collapsible accordion block on the product page.

  Accepts:
  - block: {Object} the 'size_fit_guide' block from main-product.liquid
  - section: {Object} the enclosing section

  Usage:
  {% render 'size-fit-guide', block: block, section: section %}
{% endcomment %}

<div class="product__accordion accordion size-fit-guide quick-add-hidden" {{ block.shopify_attributes }}>
  <details id="Details-{{ block.id }}-{{ section.id }}">
    <summary>
      <div class="summary__title">
        {% render 'icon-accordion', icon: 'ruler' %}
        <h2 class="h4 accordion__title">
          {{ block.settings.heading | escape }}
        </h2>
      </div>
      {% render 'icon-caret' %}
    </summary>
    <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
      <div class="size-fit-guide__table-wrapper">
        <table class="size-fit-guide__table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">
                Chest
                {%- if block.settings.unit_display == 'both' %} (in / cm){% elsif block.settings.unit_display == 'cm' %} (cm){% else %} (in){% endif -%}
              </th>
              <th scope="col">
                Length
                {%- if block.settings.unit_display == 'both' %} (in / cm){% elsif block.settings.unit_display == 'cm' %} (cm){% else %} (in){% endif -%}
              </th>
              <th scope="col">
                Shoulder
                {%- if block.settings.unit_display == 'both' %} (in / cm){% elsif block.settings.unit_display == 'cm' %} (cm){% else %} (in){% endif -%}
              </th>
            </tr>
          </thead>
          <tbody>
            {%- liquid
              assign size_codes = 's,m,l,xl' | split: ','
              assign size_labels = 'S,M,L,XL' | split: ','
            -%}
            {%- for code in size_codes -%}
              {%- liquid
                assign idx = forloop.index0
                assign label = size_labels[idx]
                assign chest_key = code | append: '_chest'
                assign length_key = code | append: '_length'
                assign shoulder_key = code | append: '_shoulder'
                assign chest_in = block.settings[chest_key]
                assign length_in = block.settings[length_key]
                assign shoulder_in = block.settings[shoulder_key]

                assign chest_display = chest_in
                assign length_display = length_in
                assign shoulder_display = shoulder_in
                if block.settings.unit_display == 'cm'
                  assign chest_display = chest_in | times: 2.54 | round: 1
                  assign length_display = length_in | times: 2.54 | round: 1
                  assign shoulder_display = shoulder_in | times: 2.54 | round: 1
                elsif block.settings.unit_display == 'both'
                  assign chest_cm = chest_in | times: 2.54 | round: 1
                  assign length_cm = length_in | times: 2.54 | round: 1
                  assign shoulder_cm = shoulder_in | times: 2.54 | round: 1
                  assign chest_display = chest_in | append: ' / ' | append: chest_cm
                  assign length_display = length_in | append: ' / ' | append: length_cm
                  assign shoulder_display = shoulder_in | append: ' / ' | append: shoulder_cm
                endif
              -%}
              <tr>
                <th scope="row">{{ label }}</th>
                <td>{{ chest_display }}</td>
                <td>{{ length_display }}</td>
                <td>{{ shoulder_display }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if block.settings.model_height != blank or block.settings.model_size != blank or block.settings.fit_type != blank -%}
        <p class="size-fit-guide__note">
          {%- if block.settings.model_height != blank -%}Model height: {{ block.settings.model_height }}.{% endif -%}
          {%- if block.settings.model_size != blank %} Wearing size {{ block.settings.model_size }}.{% endif -%}
          {%- if block.settings.fit_type != blank %} Fit: {{ block.settings.fit_type }}.{% endif -%}
        </p>
      {%- endif -%}
    </div>
  </details>
</div>

{% style %}
  .size-fit-guide summary {
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .size-fit-guide summary:hover {
    color: rgba(var(--color-foreground), 0.75);
  }

  .size-fit-guide__table-wrapper {
    overflow-x: auto;
  }

  .size-fit-guide__table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: 1.4rem;
  }

  .size-fit-guide__table th,
  .size-fit-guide__table td {
    padding: 0.8rem 1.2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    text-align: left;
  }

  .size-fit-guide__table thead th {
    background: rgba(var(--color-foreground), 0.03);
    font-weight: 600;
  }

  .size-fit-guide__table tbody th {
    font-weight: 600;
  }

  .size-fit-guide__note {
    margin: 1.2rem 0 0;
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.75);
  }
{% endstyle %}
