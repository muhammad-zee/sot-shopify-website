{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if section.blocks.size > 0 -%}
    {%- liquid
      assign block_count = section.blocks.size
      assign min_items_per_group = 24
      assign repeat_count = min_items_per_group | times: 1.0 | divided_by: block_count | ceil
      if repeat_count < 1
        assign repeat_count = 1
      endif
    -%}
    <div
      class="announcement-bar-marquee{% if section.settings.pause_on_hover %} announcement-bar-marquee--pause-on-hover{% endif %}"
      role="region"
      aria-label="{{ 'sections.header.announcement' | t }}"
      style="--marquee-duration: {{ section.settings.marquee_speed | times: block_count | times: repeat_count }}s; --marquee-item-spacing-mobile: {{ section.settings.item_spacing_mobile }}rem; --marquee-item-spacing-desktop: {{ section.settings.item_spacing_desktop }}rem;"
    >
      <div class="announcement-bar-marquee__track">
        {%- comment -%}
          Render the block set twice, back-to-back, for a seamless -50% loop.
          Each group repeats the block list enough times that a single group's
          width always exceeds the viewport, so the loop never shows a gap
          or a visible restart. Only the first real copy is exposed to
          assistive tech; every filler/mirrored copy is aria-hidden.
        {%- endcomment -%}
        {%- for i in (1..2) -%}
          <div class="announcement-bar-marquee__group">
            {%- for r in (1..repeat_count) -%}
              {%- liquid
                assign item_hidden = false
                if i == 2 or r > 1
                  assign item_hidden = true
                endif
              -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign attrs = ''
                  if i == 1 and r == 1
                    assign attrs = block.shopify_attributes
                  endif

                  assign item_classes = 'announcement-bar-marquee__item'
                  if block.settings.highlight
                    assign item_classes = item_classes | append: ' announcement-bar-marquee__item--highlight color-' | append: block.settings.highlight_color_scheme
                    if block.settings.highlight_animate
                      assign item_classes = item_classes | append: ' announcement-bar-marquee__item--animate'
                    endif
                  endif
                -%}
                <div class="{{ item_classes }}" {{ attrs }}{% if item_hidden %} aria-hidden="true"{% endif %}>
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-bar__link link link--text focus-inset animate-arrow"
                        {% if item_hidden %}tabindex="-1"{% endif %}
                      >
                    {%- endif -%}
                    <p class="announcement-bar__message h5">
                      {%- if block.settings.highlight -%}
                        <span class="badge announcement-bar-marquee__badge">{{ block.settings.text | escape }}</span>
                      {%- else -%}
                        <span>{{ block.settings.text | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.link != blank -%}
                        {% render 'icon-arrow' %}
                      {%- endif -%}
                    </p>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_social and social_icons or language_country_selector -%}
    <div class="page-width utility-bar__grid{% if section.settings.show_social and social_icons and language_country_selector %} utility-bar__grid--2-col{% endif %}">
      {%- if section.settings.show_social and social_icons -%}
        {%- render 'social-icons' -%}
      {%- endif -%}

      <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <noscript class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryMobileFormNoScript', class: 'localization-form' -%}
            <div class="localization-form__select">
              <h2 class="visually-hidden" id="AnnouncementCountryMobileLabelNoScript">
                {{ 'localization.country_label' | t }}
              </h2>
              <select
                class="localization-selector link"
                name="country_code"
                aria-labelledby="AnnouncementCountryMobileLabelNoScript"
              >
                {%- for country in localization.available_countries -%}
                  <option
                    value="{{ country.iso_code }}"
                    {%- if country.iso_code == localization.country.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }}
                    {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
              {% render 'icon-caret' %}
            </div>
            <button class="button button--tertiary">{{ 'localization.update_country' | t }}</button>
          {%- endform -%}
        </noscript>

        <localization-form class="small-hide medium-hide no-js-hidden">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <noscript class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageMobileFormNoScript', class: 'localization-form' -%}
            <div class="localization-form__select">
              <h2 class="visually-hidden" id="AnnouncementLanguageMobileLabelNoScript">
                {{ 'localization.language_label' | t }}
              </h2>
              <select
                class="localization-selector link"
                name="locale_code"
                aria-labelledby="AnnouncementLanguageMobileLabelNoScript"
              >
                {%- for language in localization.available_languages -%}
                  <option
                    value="{{ language.iso_code }}"
                    lang="{{ language.iso_code }}"
                    {%- if language.iso_code == localization.language.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
              {% render 'icon-caret' %}
            </div>
            <button class="button button--tertiary">{{ 'localization.update_language' | t }}</button>
          {%- endform -%}
        </noscript>

        <localization-form class="small-hide medium-hide no-js-hidden">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% style %}
  .announcement-bar-marquee {
    overflow: hidden;
    position: relative;
    width: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 3rem, #000 calc(100% - 3rem), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 3rem, #000 calc(100% - 3rem), transparent 100%);
    --marquee-item-spacing: var(--marquee-item-spacing-mobile, 2rem);
  }

  @media screen and (min-width: 750px) {
    .announcement-bar-marquee {
      --marquee-item-spacing: var(--marquee-item-spacing-desktop, 3rem);
    }
  }

  .announcement-bar-marquee__track {
    display: flex;
    width: max-content;
    animation: announcement-bar-marquee var(--marquee-duration, 20s) linear infinite;
  }

  .announcement-bar-marquee__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  .announcement-bar-marquee__item {
    display: flex;
    align-items: center;
    padding: 0 var(--marquee-item-spacing, 3rem);
    white-space: nowrap;
  }

  .announcement-bar-marquee__item .announcement-bar__message {
    margin: 0;
    white-space: nowrap;
  }

  /* The highlighted text renders as an actual .badge (the same compact tag
     component used for Sale/Sold out elsewhere on the site), sized by its own
     small built-in padding — not by the item or message wrapper. The message
     wrapper's default padding is zeroed here so nothing stacks on top of the
     badge's own size, and the row's height stays governed by the plain-text
     items around it (align-items: center on the group centers the smaller
     badge inside that row automatically). */
  .announcement-bar-marquee__item--highlight .announcement-bar__message {
    padding: 0;
  }

  .announcement-bar-marquee__badge {
    white-space: nowrap;
  }

  .announcement-bar-marquee__item--animate {
    animation: announcement-bar-marquee-pulse 1.6s ease-in-out infinite;
  }

  @keyframes announcement-bar-marquee-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }

  .announcement-bar-marquee--pause-on-hover:hover .announcement-bar-marquee__track,
  .announcement-bar-marquee--pause-on-hover:focus-within .announcement-bar-marquee__track {
    animation-play-state: paused;
  }

  @keyframes announcement-bar-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar-marquee__track {
      animation: none;
    }
    .announcement-bar-marquee__item--animate {
      animation: none;
    }
    .announcement-bar-marquee {
      overflow-x: auto;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content",
      "info": "t:sections.announcement-bar.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__2.content"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Speed per announcement",
      "info": "Lower is faster. Total loop time scales with the number of announcements.",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "item_spacing_mobile",
      "min": 1,
      "max": 8,
      "step": 0.5,
      "unit": "rem",
      "label": "Space between announcements (mobile)",
      "default": 2
    },
    {
      "type": "range",
      "id": "item_spacing_desktop",
      "min": 1,
      "max": 8,
      "step": 0.5,
      "unit": "rem",
      "label": "Space between announcements (desktop)",
      "default": 3
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__3.content",
      "info": "t:sections.announcement-bar.settings.header__3.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__4.content",
      "info": "t:sections.announcement-bar.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        },
        {
          "type": "header",
          "content": "Attention styling"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight this announcement",
          "info": "Style this announcement to stand out from the others, e.g. for a big sale.",
          "default": false
        },
        {
          "type": "color_scheme",
          "id": "highlight_color_scheme",
          "label": "Highlight color scheme",
          "default": "scheme-1"
        },
        {
          "type": "checkbox",
          "id": "highlight_animate",
          "label": "Pulse animation",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
