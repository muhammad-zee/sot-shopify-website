{%- comment -%}
  Emits BreadcrumbList structured data so product, collection, article and page
  URLs are eligible for breadcrumb rich results.

  Names/URLs go through the `json` filter, which emits a fully quoted and
  escaped JSON string — do not wrap these in quotes here.
{%- endcomment -%}

{%- liquid
  assign emit = false
  case request.page_type
    when 'product', 'collection', 'article', 'blog', 'page'
      assign emit = true
  endcase

  if request.page_type == 'collection' and collection.handle == blank
    assign emit = false
  endif
-%}

{%- if emit -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ shop.name | json }},
          "item": {{ shop.url | append: routes.root_url | json }}
        }
        {%- case request.page_type -%}
          {%- when 'product' -%}
            {%- if collection.handle != blank -%}
              ,{
                "@type": "ListItem",
                "position": 2,
                "name": {{ collection.title | json }},
                "item": {{ shop.url | append: collection.url | json }}
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": {{ product.title | json }},
                "item": {{ shop.url | append: product.url | json }}
              }
            {%- else -%}
              ,{
                "@type": "ListItem",
                "position": 2,
                "name": {{ product.title | json }},
                "item": {{ shop.url | append: product.url | json }}
              }
            {%- endif -%}
          {%- when 'collection' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ shop.url | append: collection.url | json }}
            }
          {%- when 'blog' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ shop.url | append: blog.url | json }}
            }
          {%- when 'article' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ shop.url | append: blog.url | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ article.title | json }},
              "item": {{ shop.url | append: article.url | json }}
            }
          {%- when 'page' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ page.title | json }},
              "item": {{ shop.url | append: page.url | json }}
            }
        {%- endcase -%}
      ]
    }
  </script>
{%- endif -%}
