{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3'
    assign heading_tag = 'h2'
  endunless

  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign content_bg_opacity = section.settings.content_background_opacity | divided_by: 100.0

  assign valid_heights = '25vh,50vh,75vh,100vh' | split: ','
  assign height_mobile = section.settings.height_mobile
  unless valid_heights contains height_mobile
    assign height_mobile = '100vh'
  endunless
  assign height_desktop = section.settings.height_desktop
  unless valid_heights contains height_desktop
    assign height_desktop = '100vh'
  endunless
  assign height_mobile_small = height_mobile | replace: 'vh', 'svh'
  assign height_desktop_small = height_desktop | replace: 'vh', 'svh'

  assign heading_rem_mobile = 3
  case section.settings.heading_size_mobile
    when 'h2'
      assign heading_rem_mobile = 2
    when 'h1'
      assign heading_rem_mobile = 3
    when 'h0'
      assign heading_rem_mobile = 4
    when 'hxl'
      assign heading_rem_mobile = 5
  endcase

  assign heading_rem_desktop = 4
  case section.settings.heading_size_desktop
    when 'h2'
      assign heading_rem_desktop = 2.4
    when 'h1'
      assign heading_rem_desktop = 4
    when 'h0'
      assign heading_rem_desktop = 5.2
    when 'hxl'
      assign heading_rem_desktop = 6.2
  endcase

  # Desktop and mobile can use entirely different image sets. If either is
  # left empty, borrow the other one so the section still shows something
  # sensible on both breakpoints with zero extra setup.
  assign desktop_blocks = section.blocks | where: 'type', 'slideshow_image'
  assign mobile_blocks = section.blocks | where: 'type', 'slideshow_image_mobile'
  if desktop_blocks.size == 0 and mobile_blocks.size > 0
    assign desktop_blocks = mobile_blocks
  endif
  if mobile_blocks.size == 0 and desktop_blocks.size > 0
    assign mobile_blocks = desktop_blocks
  endif
  assign desktop_count = desktop_blocks.size
  assign mobile_count = mobile_blocks.size

  assign slide_display_seconds = section.settings.slide_display_duration
  assign slide_transition_seconds = section.settings.slide_transition_duration
  # Transition must be meaningfully shorter than the display time, or the
  # fade-in and fade-out of the SAME image would overlap each other instead
  # of leaving a clean hold. Clamp it defensively.
  assign max_transition = slide_display_seconds | times: 0.5
  if slide_transition_seconds > max_transition
    assign slide_transition_seconds = max_transition
  endif
  # Slot spacing between consecutive images is display time only (not
  # display + transition), so each new image starts rising on top of the
  # previous one exactly display_seconds after that image started rising.
  assign slot_seconds = slide_display_seconds

  # Crossfade timing, computed once per stack since desktop/mobile can have
  # different image counts (and therefore a different total loop length).
  #
  # Each image: fades in (0 -> fade_pct%), holds fully opaque through
  # fadeout_end_pct% (which is exactly when the NEXT image finishes rising
  # on top of it and has fully covered it), then snaps to 0 immediately
  # after (snap_pct%) since it's already hidden by then. It stays at 0 for
  # the remainder of its own loop and rises again cleanly next cycle.
  #
  # This explicit reset is what keeps z-index ordering correct across
  # multiple loops — without it, an old image can stay "stuck" opaque behind
  # the scenes and wrongly bury a later image's re-entrance, which is what
  # caused images to appear to skip / stay too long / loop out of order.
  #
  # The reset is a near-instant snap (a tiny 0.1 percentage-point step)
  # rather than a gradual fade, specifically so it never overlaps in time
  # with the next image's rise — if both were fading at once, the
  # background color would peek through underneath both for an instant.
  assign total_cycle_desktop = 0
  assign fade_pct_desktop = 0
  assign hold_end_pct_desktop = 0
  assign fadeout_end_pct_desktop = 0
  assign snap_pct_desktop = 0
  if desktop_count > 1
    assign total_cycle_desktop = slot_seconds | times: desktop_count
    assign fade_pct_desktop = slide_transition_seconds | times: 1.0 | divided_by: total_cycle_desktop | times: 100
    assign hold_end_pct_desktop = slide_display_seconds | times: 1.0 | divided_by: total_cycle_desktop | times: 100
    assign fadeout_end_pct_desktop = slide_display_seconds | plus: slide_transition_seconds | times: 1.0 | divided_by: total_cycle_desktop | times: 100
    assign snap_pct_desktop = fadeout_end_pct_desktop | plus: 0.1
  endif

  assign total_cycle_mobile = 0
  assign fade_pct_mobile = 0
  assign hold_end_pct_mobile = 0
  assign fadeout_end_pct_mobile = 0
  assign snap_pct_mobile = 0
  if mobile_count > 1
    assign total_cycle_mobile = slot_seconds | times: mobile_count
    assign fade_pct_mobile = slide_transition_seconds | times: 1.0 | divided_by: total_cycle_mobile | times: 100
    assign hold_end_pct_mobile = slide_display_seconds | times: 1.0 | divided_by: total_cycle_mobile | times: 100
    assign fadeout_end_pct_mobile = slide_display_seconds | plus: slide_transition_seconds | times: 1.0 | divided_by: total_cycle_mobile | times: 100
    assign snap_pct_mobile = fadeout_end_pct_mobile | plus: 0.1
  endif
-%}

{%- style -%}
  .slideshow-hero-{{ section.id }} {
    position: relative;
    display: flex;
    overflow: hidden;
    isolation: isolate;
    align-items: {{ section.settings.content_position_mobile }};
    justify-content: {{ section.settings.content_alignment_mobile }};
    min-height: {{ height_mobile }};
    min-height: {{ height_mobile_small }};
  }

  @media screen and (min-width: 750px) {
    .slideshow-hero-{{ section.id }} {
      align-items: {{ section.settings.content_position_desktop }};
      justify-content: {{ section.settings.content_alignment_desktop }};
      min-height: {{ height_desktop }};
      min-height: {{ height_desktop_small }};
    }
  }

  /* --- BACKGROUND MEDIA ---
     Absolutely positioned and forced to 100%/100% so the source can never
     render at its native resolution or overflow the hero box. */
  .slideshow-hero__media-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background-color: {{ section.settings.background_color }};
  }

  .slideshow-hero__stack-{{ section.id }} {
    position: absolute;
    inset: 0;
  }

  /* Two independent image sets: only one is ever in the document flow /
     visible at a time, switched at the same breakpoint as everything else
     in this section. */
  .slideshow-hero__stack--mobile-{{ section.id }} {
    display: block;
  }

  .slideshow-hero__stack--desktop-{{ section.id }} {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .slideshow-hero__stack--mobile-{{ section.id }} {
      display: none;
    }

    .slideshow-hero__stack--desktop-{{ section.id }} {
      display: block;
    }
  }

  .slideshow-hero__media-{{ section.id }} img,
  .slideshow-hero__media-{{ section.id }} svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    min-width: 0;
    min-height: 0;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position_mobile }};
  }

  @media screen and (min-width: 750px) {
    .slideshow-hero__media-{{ section.id }} img,
    .slideshow-hero__media-{{ section.id }} svg {
      object-position: {{ section.settings.image_position_desktop }};
    }
  }

  /* --- IMAGE SLIDESHOW ---
     Pure CSS — no JavaScript timer involved. See the timing comment in the
     Liquid block above for how the keyframe percentages are derived. */
  {%- if desktop_count > 1 -%}
    @keyframes slideshow-hero-crossfade-desktop-{{ section.id }} {
      0% {
        opacity: 0;
      }
      {{ fade_pct_desktop }}% {
        opacity: 1;
      }
      {{ fadeout_end_pct_desktop }}% {
        opacity: 1;
      }
      {{ snap_pct_desktop }}% {
        opacity: 0;
      }
      100% {
        opacity: 0;
      }
    }

    .slideshow-hero__slide-desktop-{{ section.id }} {
      opacity: 0;
      animation-name: slideshow-hero-crossfade-desktop-{{ section.id }};
      animation-duration: {{ total_cycle_desktop }}s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
      animation-fill-mode: backwards;
    }

    {%- for block in desktop_blocks -%}
      .slideshow-hero__slide-desktop-{{ section.id }}-{{ forloop.index0 }} {
        z-index: {{ forloop.index }};
        animation-delay: {{ forloop.index0 | times: slot_seconds }}s;
      }
    {%- endfor -%}

    @media (prefers-reduced-motion: reduce) {
      .slideshow-hero__slide-desktop-{{ section.id }} {
        animation: none;
        opacity: 0;
      }

      .slideshow-hero__slide-desktop-{{ section.id }}-0 {
        opacity: 1;
      }
    }
  {%- endif -%}

  {%- if mobile_count > 1 -%}
    @keyframes slideshow-hero-crossfade-mobile-{{ section.id }} {
      0% {
        opacity: 0;
      }
      {{ fade_pct_mobile }}% {
        opacity: 1;
      }
      {{ fadeout_end_pct_mobile }}% {
        opacity: 1;
      }
      {{ snap_pct_mobile }}% {
        opacity: 0;
      }
      100% {
        opacity: 0;
      }
    }

    .slideshow-hero__slide-mobile-{{ section.id }} {
      opacity: 0;
      animation-name: slideshow-hero-crossfade-mobile-{{ section.id }};
      animation-duration: {{ total_cycle_mobile }}s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
      animation-fill-mode: backwards;
    }

    {%- for block in mobile_blocks -%}
      .slideshow-hero__slide-mobile-{{ section.id }}-{{ forloop.index0 }} {
        z-index: {{ forloop.index }};
        animation-delay: {{ forloop.index0 | times: slot_seconds }}s;
      }
    {%- endfor -%}

    @media (prefers-reduced-motion: reduce) {
      .slideshow-hero__slide-mobile-{{ section.id }} {
        animation: none;
        opacity: 0;
      }

      .slideshow-hero__slide-mobile-{{ section.id }}-0 {
        opacity: 1;
      }
    }
  {%- endif -%}

  /* Overlay sits between the media and the content */
  .slideshow-hero__overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    {% if section.settings.overlay_style == 'gradient' %}
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0) 0%,
        {{ section.settings.overlay_color | color_modify: 'alpha', overlay_opacity }} 100%
      );
    {% else %}
      background-color: {{ section.settings.overlay_color | color_modify: 'alpha', overlay_opacity }};
    {% endif %}
  }

  .slideshow-hero__content-{{ section.id }} {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: {{ section.settings.content_alignment_mobile }};
    width: 100%;
    border-radius: 0;
    {%- if section.settings.content_color_scheme != blank -%}
      background-color: rgba(var(--color-background), {{ content_bg_opacity }});
    {%- else -%}
      background-color: {{ section.settings.content_background_color | color_modify: 'alpha', content_bg_opacity }};
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    .slideshow-hero__content-{{ section.id }} {
      justify-content: {{ section.settings.content_alignment_desktop }};
    }
  }

  .slideshow-hero__content-inner-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
    text-align: {{ section.settings.text_alignment }};
    color: {{ section.settings.text_color }};
  }

  .slideshow-hero__heading-{{ section.id }} {
    margin: 0;
    color: {{ section.settings.text_color }};
    word-break: break-word;
    font-size: calc(var(--font-heading-scale) * {{ heading_rem_mobile }}rem);
  }

  @media screen and (min-width: 750px) {
    .slideshow-hero__heading-{{ section.id }} {
      font-size: calc(var(--font-heading-scale) * {{ heading_rem_desktop }}rem);
    }
  }

  .slideshow-hero__text-{{ section.id }} {
    margin: 1.5rem 0 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.6;
  }

  .slideshow-hero__text-{{ section.id }} > *:first-child {
    margin-top: 0;
  }

  .slideshow-hero__text-{{ section.id }} > *:last-child {
    margin-bottom: 0;
  }

  .slideshow-hero__text-{{ section.id }} a {
    color: inherit;
  }

  /* --- OUTLINE BUTTON ---
     Deliberately not using .button so the colors stay readable over the
     slideshow regardless of which colour scheme the section is set to. */
  .slideshow-hero__button-{{ section.id }} {
    display: inline-block;
    margin-top: 2.5rem;
    padding: 1.2rem 3.2rem;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_color }};
    border-radius: {{ section.settings.button_corner_radius }}px;
    background-color: transparent;
    color: {{ section.settings.button_color }};
    font-size: 1.5rem;
    letter-spacing: 0.06rem;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .slideshow-hero__button-{{ section.id }}:hover,
  .slideshow-hero__button-{{ section.id }}:focus-visible {
    background-color: {{ section.settings.button_color }};
    color: {{ section.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .slideshow-hero__content-inner-{{ section.id }} {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .slideshow-hero__button-{{ section.id }} {
      margin-top: 2rem;
      padding: 1.1rem 2.6rem;
    }
  }
{%- endstyle -%}

<div class="slideshow-hero-{{ section.id }} color-{{ section.settings.color_scheme }}">
  <div class="slideshow-hero__media-{{ section.id }}">
    <div class="slideshow-hero__stack-{{ section.id }} slideshow-hero__stack--desktop-{{ section.id }}">
      {%- for block in desktop_blocks -%}
        {%- if block.settings.image != blank -%}
          {%- liquid
            assign slide_loading = 'lazy'
            if forloop.index0 == 0
              assign slide_loading = 'eager'
            endif
            assign slide_class = 'slideshow-hero__slide-desktop-' | append: section.id
            if desktop_count > 1
              assign slide_class = slide_class | append: ' slideshow-hero__slide-desktop-' | append: section.id | append: '-' | append: forloop.index0
            else
              assign slide_class = slide_class | append: '-static'
            endif
          -%}
          {{
            block.settings.image
            | image_url: width: 3840
            | image_tag:
              loading: slide_loading,
              sizes: '100vw',
              widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840',
              alt: block.settings.alt,
              class: slide_class
          }}
        {%- endif -%}
      {%- endfor -%}

      {%- if desktop_count == 0 -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="slideshow-hero__stack-{{ section.id }} slideshow-hero__stack--mobile-{{ section.id }}">
      {%- for block in mobile_blocks -%}
        {%- if block.settings.image != blank -%}
          {%- liquid
            assign slide_loading = 'lazy'
            if forloop.index0 == 0
              assign slide_loading = 'eager'
            endif
            assign slide_class = 'slideshow-hero__slide-mobile-' | append: section.id
            if mobile_count > 1
              assign slide_class = slide_class | append: ' slideshow-hero__slide-mobile-' | append: section.id | append: '-' | append: forloop.index0
            else
              assign slide_class = slide_class | append: '-static'
            endif
          -%}
          {{
            block.settings.image
            | image_url: width: 3840
            | image_tag:
              loading: slide_loading,
              sizes: '100vw',
              widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840',
              alt: block.settings.alt,
              class: slide_class
          }}
        {%- endif -%}
      {%- endfor -%}

      {%- if mobile_count == 0 -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="slideshow-hero__overlay-{{ section.id }}"></div>
  {%- endif -%}

  <div class="slideshow-hero__content-{{ section.id }}{% if section.settings.content_color_scheme != blank %} color-{{ section.settings.content_color_scheme }}{% endif %}">
    <div class="slideshow-hero__content-inner-{{ section.id }}">
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="slideshow-hero__heading-{{ section.id }} inline-richtext">
          {{ section.settings.heading }}
        </{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="slideshow-hero__text-{{ section.id }} rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="slideshow-hero__button-{{ section.id }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Slideshow Hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Slideshow images" },
    {
      "type": "paragraph",
      "content": "Add Desktop image and Mobile image blocks below, in the order you want each to play. If you only add one type, it's used for both screen sizes."
    },
    {
      "type": "range",
      "id": "slide_display_duration",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "label": "Time per image",
      "info": "How long each image stays fully visible before dissolving into the next.",
      "default": 4
    },
    {
      "type": "range",
      "id": "slide_transition_duration",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "unit": "s",
      "label": "Dissolve transition length",
      "default": 1
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "info": "Crop to fill always fills the section but may crop the edges of the image. Show full image never crops, but can show empty bars filled with the Background fill color below.",
      "options": [
        { "value": "cover", "label": "Crop to fill" },
        { "value": "contain", "label": "Show full image" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Desktop focal point",
      "info": "Which part of each image stays in frame when it is cropped to the hero size.",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Middle left" },
        { "value": "center center", "label": "Middle center" },
        { "value": "right center", "label": "Middle right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Mobile focal point",
      "info": "Portrait screens often need a different crop than desktop — e.g. tighter on the subject.",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Middle left" },
        { "value": "center center", "label": "Middle center" },
        { "value": "right center", "label": "Middle right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ],
      "default": "center center"
    },
    { "type": "color", "id": "background_color", "label": "Background fill", "default": "#000000" },
    { "type": "header", "content": "Overlay" },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "solid", "label": "Solid tint" },
        { "value": "gradient", "label": "Gradient (fades in at the bottom)" }
      ],
      "default": "solid"
    },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 45
    },
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Built for the ride ahead" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "info": "Use H1 only if this is the first section on the page and no other section uses H1. One H1 per page.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_size_desktop",
      "label": "Desktop heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell your story in a sentence or two. Keep it short so it stays readable over the slideshow.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "header", "content": "Content background" },
    {
      "type": "paragraph",
      "content": "A background box behind the heading, text and button — separate from the overlay over the slideshow images."
    },
    {
      "type": "color",
      "id": "content_background_color",
      "label": "Content background color",
      "info": "Used when no content color scheme is selected below.",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "content_background_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Content background opacity",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "content_color_scheme",
      "label": "Content color scheme",
      "info": "Overrides the content background color above with a theme color scheme. Choose None to use the custom color instead.",
